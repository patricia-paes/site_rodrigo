# Three independent experiences; legacy personal URLs retain permanent redirects.
DirectoryIndex index.php index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^personal\.?$ /personal/ [R=301,L]
  RewriteRule ^(metodo-4p|sobre-rodrigo-victor|personal-trainer-botafogo|personal-trainer-condominio|personal-trainer-online)(?:/index\.(?:html|php))?/?$ /personal/$1/ [R=301,L]
  # Institutional aliases linked from the homepage; the Portuguese pages stay canonical.
  RewriteRule ^about/?$ /sobre/ [R=301,L]
  RewriteRule ^contact/?$ /contato/ [R=301,L]
  RewriteRule ^privacy/?$ /privacidade.html [R=301,L]
  RewriteRule ^terms/?$ /termos/ [R=301,L]
  RewriteRule ^index\.html$ index.php [L]
  RewriteRule ^(personal|visionair)/index\.html$ $1/index.php [L]
  RewriteRule ^mcp/server-card/?$ .well-known/mcp/server-card.json [L]
  RewriteRule ^(personal|visionair)/mcp/server-card/?$ $1/.well-known/mcp/server-card.json [L]
</IfModule>
<IfModule mod_mime.c>
  AddType text/markdown .md
  AddCharset UTF-8 .md .txt .json
</IfModule>
